{
  "expo": {
    "name": "Iron Strength",
    "slug": "iron-strength-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#005fd9",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/icon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-font",
      "expo-sqlite"
    ],
    "scheme": "iron-strength",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1374e5c4-2620-4034-b8b7-e32e479ff9c8"
      }
    },
    "owner": "domarchis"
  }
}
