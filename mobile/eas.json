{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_URL": "https://iron-strength-seven.vercel.app",
        "EXPO_PUBLIC_ALLOW_LOCAL_API": "0"
      }
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_URL": "https://iron-strength-seven.vercel.app",
        "EXPO_PUBLIC_ALLOW_LOCAL_API": "0"
      },
      "ios": {
        "env": {
          "IRON_CAPTURE_IOS_BUILD_EVIDENCE": "1"
        },
        "buildArtifactPaths": [
          ".build-evidence/ios.map",
          ".build-evidence/ios.hbc",
          ".build-evidence/ios-proof.json"
        ]
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://iron-strength-seven.vercel.app",
        "EXPO_PUBLIC_ALLOW_LOCAL_API": "0"
      },
      "ios": {
        "env": {
          "IRON_CAPTURE_IOS_BUILD_EVIDENCE": "1"
        },
        "buildArtifactPaths": [
          ".build-evidence/ios.map",
          ".build-evidence/ios.hbc",
          ".build-evidence/ios-proof.json"
        ]
      }
    }
  }
}
