# Copia este archivo a .env.local. Nunca commitees .env.local ni pegues estos valores en chats.
# Los valores de abajo son los de la pila LOCAL (`npx supabase status`); en producción van los del proyecto real.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. Jamás con prefijo NEXT_PUBLIC_. Se usa en: registro por invitación,
# enlace de restablecimiento y control de intentos de login.
SUPABASE_SECRET_KEY=

# URL pública de la app (para armar enlaces de invitación y de restablecimiento).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
